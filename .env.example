# VITE_GEMINI_API_KEY: Required for browser-side Gemini API calls.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional PHP guest proxy URL. Defaults to /api/generate.php.
VITE_GEMINI_PROXY_URL="/api/generate.php"

# Configure this only on the PHP server, never in Vite or the frontend bundle.
# GUEST_GEMINI_API_KEY="server-side-secret"

# Confidential Google OAuth backend settings (PHP server only).
GOOGLE_OAUTH_CLIENT_ID="your-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://your-domain.example/api/google/callback.php"
GOOGLE_CLOUD_PROJECT_ID="your-google-cloud-project-id"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
